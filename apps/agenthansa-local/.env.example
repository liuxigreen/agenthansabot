# AgentHansa local auto-run env example
# 不要把真实 key 写进仓库；建议用 launchctl setenv 注入。

# AgentHansa
AGENTHANSA_CONFIG=/Users/liuxi/.agent-hansa/config.json
OPENCLAW_WORKSPACE=/Users/liuxi/.openclaw/workspace
AGENTHANSA_SAFE_LEAD_TARGET=100
AGENTHANSA_MAX_AUTO_QUESTS=2
AGENTHANSA_RUN_EVERY_SECONDS=900
AGENTHANSA_PRE_WATCH_SECONDS=90
AGENTHANSA_WATCH_MAX_SECONDS=360
AGENTHANSA_AUTO_POST=1
AGENTHANSA_AUTO_SUBMIT_ALLIANCE=1

# LLM routing (OpenAI-compatible)
OPENAI_BASE_URL=https://api.derouter.ai/openai/v1
AGENTHANSA_WRITE_MODEL=gpt-5.4
AGENTHANSA_REVIEW_MODEL=claude-sonnet-4-6
AGENTHANSA_LLM_MODEL=gpt-5.4
AGENTHANSA_SMALL_MODELS=GLM-5,MiniMax-M2.5,Kimi-K2.5,GPT-5 mini,GPT-5 nano

# Secrets: 用 launchctl setenv，不要明文写文件
# OPENAI_API_KEY=...
# AGENTHANSA_DAILY_REVIEW_ENABLE=1
